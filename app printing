 try{const t=totals(C);let no=C.editNo;
  if(!no){const n=await DB.next('qtn');no=`QTN-${new Date().getFullYear()}-${String(n).padStart(3,'0')}`}
  const old=getQ(no),calc=JSON.parse(JSON.stringify(C));delete calc.editNo;
  const d={no,cust:C.cust,phone:normPhone(C.phone),job:C.job,qty:num(C.qty),calc,t,designData:old?old.designData||'':'',designName:old?old.designName||'':'',spkStatus:old?old.spkStatus||'':'',spkAt:old?old.spkAt||0:0,spkBy:old?old.spkBy||'':'',real:old?old.real||null:null,createdBy:old?old.createdBy:ME.name,createdAt:old?old.createdAt:Date.now(),updatedAt:Date.now()};
  await DB.set('quotations',no,d);d.id=no;const ix=S.qtns.findIndex(q=>q.id===no);if(ix>=0)S.qtns[ix]=d;else S.qtns.push(d);S.projects.filter(p=>p.qtnRef===no).forEach(p=>pubTrack(p));
  C.editNo=no;curQ=no;const sel_=$('#csel');if(sel_)sel_.innerHTML='<option value="">Pilih penawaran tersimpan</option>'+qopt(no);
