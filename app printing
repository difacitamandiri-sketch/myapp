 const sum=[['Biaya kertas',rp(t.paper)],['Biaya plat CTP',rp(t.plate)],['Ongkos cetak mesin',rp(t.press)],['Biaya finishing',rp(t.fin)],['<b>Total modal (HPP)</b>','<b>'+rp(t.hpp)+'</b>'],[`Margin / profit (${num(c.margin)}%)`,rp(t.profit)],['Laba per eksemplar',rp(num(c.qty)>0?t.profit/num(c.qty):0)]];
