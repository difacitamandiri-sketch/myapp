function fileData(f,max,qlt){return new Promise((res,rej)=>{const r=new FileReader();
 if(f.type.startsWith('image/')){r.onload=()=>{const im=new Image();im.onload=()=>{const k=Math.min(1,max/Math.max(im.width,im.height)),cv=document.createElement('canvas');cv.width=im.width*k;cv.height=im.height*k;cv.getContext('2d').drawImage(im,0,0,cv.width,cv.height);res(cv.toDataURL('image/jpeg',qlt||.75))};im.onerror=()=>rej(new Error('File gambar tidak valid'));im.src=r.result};}
 else{if(f.size>700000)return rej(new Error('Ukuran file PDF maksimal 700 KB'));r.onload=()=>res(r.result)}
 r.readAsDataURL(f)})}

