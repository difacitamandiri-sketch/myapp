function totals(c){const plates=c.colors.reduce((s,x)=>s+(PL[x.v]||0),0),plano=c.papers.reduce((s,p)=>s+num(p.qty),0),
 paper=c.papers.reduce((s,p)=>s+num(p.qty)*num(p.price),0),plate=c.presses.reduce((s,m)=>s+plates*num(m.plate),0),
 press=c.presses.reduce((s,m)=>s+num(m.c1000)+num(m.sheets)*num(m.pps),0),
 fin=c.fins.reduce((s,f)=>s+num(f.qty)*(f.type==='pcs'?num(f.price):num(f.len)*num(f.wid)*num(f.pcm)),0),
 hpp=paper+plate+press+fin,profit=hpp*num(c.margin)/100,grand=hpp+profit;
 return{plates,plano,paper,plate,press,fin,hpp,profit,grand,unit:num(c.qty)>0?grand/num(c.qty):0}}
